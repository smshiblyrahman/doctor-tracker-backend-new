{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.tsx",
    "*/src/**/*.tsx",
    "*/tests/**/*.tsx",
    "*/server.tsx",
    "scripts/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist"]
}
