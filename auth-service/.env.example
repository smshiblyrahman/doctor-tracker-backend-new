PORT=5001
MONGO_URI=mongodb://localhost:27017/doctor_tracker_auth
NODE_ENV=development

# Must match the API gateway's JWT_ACCESS_SECRET (the gateway verifies access tokens)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
# Must be identical across all services
INTERNAL_JWT_SECRET=dev-internal-secret-change-me-0123456789abcd

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seeded on first start when no admin user exists
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@doctortracker.dev
ADMIN_PASSWORD=Admin@12345
