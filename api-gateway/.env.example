PORT=5000
AUTH_SERVICE_URL=http://localhost:5001
DOCTOR_SERVICE_URL=http://localhost:5002
PATIENT_SERVICE_URL=http://localhost:5003
DASHBOARD_SERVICE_URL=http://localhost:5004
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:3000

# Must match auth-service's JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
# Must be identical across all services
INTERNAL_JWT_SECRET=dev-internal-secret-change-me-0123456789abcd

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=10
